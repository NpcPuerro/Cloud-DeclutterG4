<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".MainActivity">

<androidx.constraintlayout.widget.ConstraintLayout
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorPrimary"
        app:title="@string/cloud_title"
        app:titleTextColor="@color/white"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Google Drive -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/HeaderTextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Google Drive" />


                    <TextView
                        android:id="@+id/account_google"
                        style="@style/BigTextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Konto: user@gmail.com" />

                    <Button
                        android:id="@+id/btn_connect_google"
                        style="@style/BigButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_connect"
                        android:visibility="gone" />


                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_google"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/active_for_scans"
                        android:textSize="20sp" />

                    <Button
                        android:id="@+id/btn_disconnect_google"
                        style="@style/BigButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/btn_disconnect"
                        android:backgroundTint="#FF4444" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Dropbox -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/HeaderTextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dropbox" />

                    <TextView
                        android:id="@+id/status_dropbox"
                        style="@style/BigTextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_not_connected"
                        android:textColor="#666666" />

                    <TextView
                        android:id="@+id/account_dropbox"
                        style="@style/BigTextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Konto: user@gmail.com"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_connect_dropbox"
                        style="@style/BigButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_connect" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_dropbox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/active_for_scans"
                        android:textSize="20sp"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/btn_disconnect_dropbox"
                        style="@style/BigButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/btn_disconnect"
                        android:backgroundTint="#FF4444"
                        android:visibility="gone" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- OneDrive -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/HeaderTextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OneDrive" />

                    <TextView
                        android:id="@+id/account_onedrive"
                        style="@style/BigTextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Konto: user@gmail.com" />

                    <Button
                        android:id="@+id/btn_connect_onedrive"
                        style="@style/BigButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_connect"
                        android:visibility="gone" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_onedrive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/active_for_scans"
                        android:textSize="20sp" />

                    <Button
                        android:id="@+id/btn_disconnect_onedrive"
                        style="@style/BigButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/btn_disconnect"
                        android:backgroundTint="#FF4444" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- iCloud -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/HeaderTextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="iCloud" />

                    <TextView
                        android:id="@+id/account_icloud"
                        style="@style/BigTextStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Konto: user@gmail.com" />

                    <Button
                        android:id="@+id/btn_connect_icloud"
                        style="@style/BigButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/btn_connect"
                        android:visibility="gone" />

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_icloud"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/active_for_scans"
                        android:textSize="20sp" />

                    <Button
                        android:id="@+id/btn_disconnect_icloud"
                        style="@style/BigButtonStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/btn_disconnect"
                        android:backgroundTint="#FF4444" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:id="@+id/dynamic_cloud_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <Button
                android:id="@+id/btn_add_cloud_service"
                style="@style/BigButtonStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/btn_add_cloud" />
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>

<com.google.android.material.navigation.NavigationView
android:id="@+id/nav_view"
android:layout_width="wrap_content"
android:layout_height="wrap_content"
android:layout_gravity="start"
app:itemTextAppearanceActive="@style/NavMenuItemStyle"
app:itemTextAppearanceInactive="@style/NavMenuItemStyle"
app:itemVerticalPadding="12dp"
app:menu="@menu/drawer_menu" />

    </androidx.drawerlayout.widget.DrawerLayout>
